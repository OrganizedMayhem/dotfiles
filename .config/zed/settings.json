{
    "context_servers": {
        "mcp-server-github": {
            "enabled": true,
            "remote": false,
        },
    },
    "edit_predictions": {
        "zed": {
            "prediction_debounce": 100,
        },
        "provider": "zed",
    },
    "cli_default_open_behavior": "existing_window",
    "git_panel": {
        "dock": "right",
    },
    "ssh_connections": [
        {
            "host": "utility",
            "args": [],
            "projects": [
                {
                    "paths": ["/opt/n8n"],
                },
            ],
        },
    ],
    "icon_theme": "Material Icon Theme",
    "agent": {
        "sandbox_permissions": {
            "network_hosts": [
                "registry.opentofu.org",
                "registry.terraform.io",
                "releases.hashicorp.com",
                "github.com",
                "objects.githubusercontent.com",
                "release-assets.githubusercontent.com",
            ],
        },
        "dock": "left",
        "default_model": {
            "effort": "high",
            "provider": "copilot_chat",
            "model": "claude-opus-4.8",
            "enable_thinking": true,
        },
    },
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "theme": "Ayu Dark",
    "ui_font_size": 18,
    "buffer_font_size": 18,
    "ui_font_family": "FiraCode Nerd Font",
    "vim_mode": false,
    "cursor_blink": true,
    "show_whitespaces": "selection",
    "wrap_guides": [80, 120],
    "preferred_line_length": 88,
    "soft_wrap": "preferred_line_length",
    "tab_size": 4,
    "auto_indent": "syntax_aware",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "format_on_save": "on",
    "confirm_quit": true,
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true,
            "delay_ms": 600,
        },
    },
    "file_types": {
        "Dockerfile": ["Dockerfile*"],
        "JSON": ["*.json", ".zed/settings.json"],
        "YAML": ["*.yml", "*.yaml"],
        "Go": ["*.go"],
        "Python": ["*.py", "*.pyi"],
    },
    "languages": {
        "Python": {
            "format_on_save": "on",
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": false,
            "preferred_line_length": 88,
            "language_servers": ["basedpyright"],
        },
        "Go": {
            "format_on_save": "on",
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true,
            "preferred_line_length": 100,
        },
        "JSON": {
            "tab_size": 2,
            "hard_tabs": false,
        },
        "YAML": {
            "tab_size": 2,
            "hard_tabs": false,
        },
        "Markdown": {
            "soft_wrap": "preferred_line_length",
            "preferred_line_length": 80,
        },
    },
    "lsp": {
        "terraform-ls": {
            "initialization_options": {
                "experimentalFeatures": {
                    "prefillRequiredFields": true,
                },
            },
        },
        "basedpyright": {
            "settings": {
                "basedpyright": {
                    "analysis": {
                        "typeCheckingMode": "standard",
                        "diagnosticMode": "workspace",
                        "autoSearchPaths": true,
                        "useLibraryCodeForTypes": true,
                        "autoImportCompletions": true,
                        "inlayHints": {
                            "variableTypes": true,
                            "functionReturnTypes": true,
                            "callArgumentNames": true,
                            "pytestParameters": true,
                        },
                    },
                },
            },
        },
        "gopls": {
            "initialization_options": {
                "usePlaceholders": true,
                "completeUnimported": true,
                "deepCompletion": true,
                "matcher": "fuzzy",
                "staticcheck": true,
                "experimentalWorkspaceModule": true,
            },
            "settings": {
                "gopls": {
                    "analyses": {
                        "unusedparams": true,
                        "shadow": true,
                        "fieldalignment": true,
                        "nilness": true,
                        "unusedwrite": true,
                        "useany": true,
                    },
                    "hints": {
                        "assignVariableTypes": true,
                        "compositeLiteralFields": true,
                        "compositeLiteralTypes": true,
                        "constantValues": true,
                        "functionTypeParameters": true,
                        "parameterNames": true,
                        "rangeVariableTypes": true,
                    },
                    "formatting": {
                        "gofumpt": true,
                    },
                    "importShortcut": "Both",
                    "linkTarget": "pkg.go.dev",
                    "local": "",
                    "verboseOutput": false,
                },
            },
        },
        "lua-language-server": {
            "settings": {
                "Lua": {
                    "runtime": {
                        "version": "LuaJIT",
                    },
                    "diagnostics": {
                        "globals": ["vim", "Snacks"],
                    },
                    "workspace": {
                        // Zed doesn't set $VIMRUNTIME, so use the absolute path.
                        "library": [
                            "/usr/share/nvim/runtime",
                            "${3rd}/luv/library",
                            "~/.local/share/nvim/lazy/snacks.nvim",
                        ],
                        "checkThirdParty": false,
                    },
                    "format": {
                        "enable": false,
                    },
                    "telemetry": {
                        "enable": false,
                    },
                },
            },
        },
    },
    "collaboration_panel": {
        "dock": "right",
        "button": true,
    },
    "outline_panel": {
        "dock": "right",
        "button": true,
        "default_width": 240,
    },
    "project_panel": {
        "button": true,
        "default_width": 240,
        "dock": "right",
        "git_status": true,
    },
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
    },
    "search": {
        "whole_word": false,
        "case_sensitive": false,
        "include_ignored": false,
        "regex": false,
    },
    "preview_tabs": {
        "enabled": true,
        "enable_preview_from_file_finder": true,
    },
}
